# macOS
.DS_Store

# Terraform local directories
.terraform/
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files with real values
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!*.tfvars.example.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Local plans
*.tfplan
tfplan

# Local environment files
.env
.env.*
!.env.example
