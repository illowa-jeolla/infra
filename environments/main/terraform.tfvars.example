aws_region  = "ap-northeast-2"
project     = "illowa-jeolla"
environment = "main"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "ap-northeast-2a",
  "ap-northeast-2c",
]

public_subnet_cidrs = [
  "10.0.0.0/24",
  "10.0.1.0/24",
]

private_app_subnet_cidrs = [
  "10.0.10.0/24",
  "10.0.11.0/24",
]

private_data_subnet_cidrs = [
  "10.0.20.0/24",
  "10.0.21.0/24",
]

ecr_max_image_count               = 30
ecr_untagged_image_retention_days = 7

postgres_engine_version   = "17.11"
postgres_instance_class   = "db.t4g.micro"
postgres_allocated_storage = 20
postgres_password_version  = 1

redis_engine_version      = "7.1"
redis_node_type           = "cache.t4g.micro"
redis_auth_token_version  = 1

api_domain_name = "api.illowa-jeolla.cloud"
api_certificate_domain_names = [
  "api.cltrmp.cloud",
  "api.illowa-jeolla.cloud",
]
api_image_tag          = "225fca632481"
api_task_cpu           = 512
api_task_memory        = 1024
api_desired_count      = 0
api_log_retention_days = 14

# Configure these values before changing api_desired_count to 1.
api_environment = {
  # JWT_ACCESS_EXPIRATION       = "3600000"
  # JWT_REFRESH_EXPIRATION      = "1209600000"
  # JWT_COOKIE_SECURE           = "true"
  # KAKAO_CLIENT_ID             = "non-secret-client-id"
  # KAKAO_REDIRECT_URI          = "https://api.illowa-jeolla.cloud/api/v1/auth/kakao/callback"
  # GOOGLE_CLIENT_ID            = "non-secret-client-id"
  # GOOGLE_REDIRECT_URI         = "https://api.illowa-jeolla.cloud/api/v1/auth/google/callback"
  # FRONTEND_OAUTH_CALLBACK_URI = "https://illowa-jeolla.cloud/oauth/callback"
  # FRONTEND_ORIGIN             = "https://illowa-jeolla.cloud"
}

# Values are SSM parameter ARNs, not secret values.
api_secret_parameter_arns = {
  # JWT_SECRET           = "arn:aws:ssm:ap-northeast-2:123456789012:parameter/illowa-jeolla/main/jwt/secret"
  # KAKAO_CLIENT_SECRET  = "arn:aws:ssm:ap-northeast-2:123456789012:parameter/illowa-jeolla/main/oauth/kakao/client-secret"
  # GOOGLE_CLIENT_SECRET = "arn:aws:ssm:ap-northeast-2:123456789012:parameter/illowa-jeolla/main/oauth/google/client-secret"
}
